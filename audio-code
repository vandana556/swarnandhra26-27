# Audio Page

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Audio Page</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="container">
        <header class="header">
            <h1>Audio Messages</h1>
        </header>
        <main class="main-content">
            <div class="audio-message">
                <audio controls>
                    <source src="audio/sample-audio.mp3" type="audio/mpeg">
                    Your browser does not support the audio element.
                </audio>
                <div class="audio-info">
                    <span class="sender">From: John Doe</span>
                    <span class="timestamp">12:34 PM</span>
                </div>
            </div>
        </main>
        <footer class="footer">
            <input type="text" placeholder="Type a message..." class="message-input">
            <button class="send-button">Send</button>
        </footer>
    </div>
    <script src="script.js"></script>
</body>
</html>

