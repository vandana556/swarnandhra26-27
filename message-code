# WhatsApp Messenger Page Clone

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>WhatsApp Messenger Clone</title>
    <link rel="stylesheet" href="styles.css">
</head>
<body>
    <div class="container">
        <div class="sidebar">
            <div class="header">
                <h1>WhatsApp</h1>
            </div>
            <div class="chat-list">
                <div class="chat-item">Chat 1</div>
                <div class="chat-item">Chat 2</div>
                <div class="chat-item">Chat 3</div>
            </div>
        </div>
        <div class="chat-window">
            <div class="chat-header">
                <h2>Chat with User</h2>
            </div>
            <div class="messages">
                <div class="message sent">Hello!</div>
                <div class="message received">Hi there!</div>
            </div>
            <div class="input-area">
                <input type="text" placeholder="Type a message...">
                <button>Send</button>
            </div>
        </div>
    </div>
    <script src="script.js"></script>
</body>
</html>

